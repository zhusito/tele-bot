# Token dari @BotFather
BOT_TOKEN=isi_token_bot

# ID Telegram kamu (owner). Cek lewat @userinfobot
OWNER_ID=123456789

# ID grup pool report (angka negatif, biasanya diawali -100).
# Cara dapat: masukkan bot ke grup, ketik /id di grup itu.
POOL_CHAT_ID=-1001234567890

# Opsional: lokasi file database SQLite (default: ./data/bot-report.sqlite)
# DATABASE_PATH=./data/bot-report.sqlite
